# Ozu configuration. Copy to ~/ozu-data/.env (deploy/install.sh does it) and
# chmod 600 — it holds your API key and SMTP password.
#
# NOTE: no inline comments after a value. This file is read both by Python
# and by systemd's EnvironmentFile=, and neither strips a trailing `# ...` —
# it would become part of the value.

# --- required ----------------------------------------------------------------
# From console.anthropic.com. Pays for the vision calls (a few cents a page).
ANTHROPIC_API_KEY=sk-ant-...
# Working dir: database, raw exports, page images, logs, editions.
OZU_HOME=/home/USER/ozu-data
# The vault: a git repo of Markdown notes. `ozu init` creates it.
OZU_VAULT_DIR=/home/USER/ozu-data/vault

# --- capture: where your tablet's PDF exports land ----------------------------
# An rclone remote:path. The Kindle Scribe exports to Google Drive; any device
# that can drop PDFs into a synced folder works the same way.
OZU_RCLONE_REMOTE=gdrive:ScribeInbox

# --- routing ------------------------------------------------------------------
# Project tags a handwritten @tag may route to, comma-separated. `ideas` and
# `people` always exist, and every repo in OZU_CLAUDE_REPOS is a tag too.
OZU_PROJECTS=garden,house
# Renamed a topic? `old:new` pairs, comma-separated, case-insensitive. The old
# name stays accepted everywhere (an `@old` tag, an answer of `old`, an `old=`
# key in OZU_CLAUDE_REPOS, OZU_ISA_TOPICS, the MCP timeline/capture arguments)
# and always lands on `new`, so `topics/old/` is never reopened. One step, no
# chaining. A malformed entry (no colon, an empty side) is ignored.
OZU_TOPIC_ALIASES=

# --- models ---------------------------------------------------------------------
# OZU_MODEL reads notebook pages (the original capture); OZU_ANNOTATION_MODEL
# reads Ozu documents coming back annotated, a narrower job. Haiku 4.5 does
# NOT work here: it rejects the reasoning effort these calls send.
OZU_MODEL=claude-opus-5
OZU_ANNOTATION_MODEL=claude-sonnet-5
OZU_MAX_PAGES_PER_RUN=40
OZU_MAX_PAGES_PER_DAY=120

# --- delivery back to the device (Send-to-Kindle) -----------------------------
# All of KINDLE_EMAIL / SMTP_USER / SMTP_PASS must be set, or editions stay
# local PDFs in ~/ozu-data/editions. The sender address must be on Amazon's
# approved personal-document list.
OZU_KINDLE_EMAIL=
OZU_SMTP_HOST=smtp.example.com
OZU_SMTP_PORT=587
OZU_SMTP_USER=
OZU_SMTP_PASS=

# --- names on the device -------------------------------------------------------
# OZU_BRAND is the name every document Ozu sends carries: file names
# ("<brand> Morning <date>", "<brand> Build r2 - <title> (<id>)"), the PDF
# Author the device sorts on, and the page stamps ink is routed back by.
# OZU_DIGEST_PREFIXES is how documents coming back are recognised: a notebook
# whose name starts with one of these (comma-separated, case-insensitive) is
# one of ours, annotated, and the Build stamps are matched under every one of
# them. If your device already holds documents sent under another name, keep
# that name here alongside the current one, or ink on them stops routing.
OZU_BRAND=Ozu
OZU_DIGEST_PREFIXES=ozu

# --- @claude Builds and @research (headless Claude Code) ----------------------
# topic=git-url pairs, comma-separated. Only mapped topics can ever open a
# Build; branches are pushed as build/<id>, never main.
OZU_CLAUDE_REPOS=kettle=git@github.com:you/kettle.git
# Fine-grained PAT (Pull requests: read-write, scoped to the mapped repos).
# Without it, a Build pushes its branch and reports a compare link instead.
OZU_GITHUB_TOKEN=
# Projects whose proposals are shaped as an ISA instead: an ideal state, the
# decisions, and numbered steps that each name the check proving them; the
# run then reports every step as pass, fail or not verified. Empty = the
# usual requirement-and-plan shape everywhere.
OZU_ISA_TOPICS=
# Headless runs use the `claude` CLI's own login. Per-tick and per-Build
# budgets: a tick fires every five minutes, so the lifetime cap per Build is
# what actually bounds a retry loop (see DESIGN.md, "attempt budget").
OZU_MAX_BUILD_RUNS=2
OZU_MAX_BUILD_ATTEMPTS=3
OZU_MAX_RESEARCH_RUNS=2
OZU_MAX_LEARN_RUNS=3
# The wiki: one run per cycle folds at most this many new notes into at most
# this many concept pages, so each rewrite stays reviewable in one diff.
OZU_MAX_WIKI_NOTES=6
OZU_MAX_WIKI_PAGES=5
OZU_CLAUDE_TIMEOUT=1800
# Empty = the claude CLI's default model.
OZU_PROPOSE_MODEL=
OZU_RESEARCH_MODEL=
OZU_WIKI_MODEL=
# Learning briefs only summarise a transcript they were handed, so a lighter
# model is the default.
OZU_LEARN_MODEL=claude-sonnet-5

# --- the work wall ---------------------------------------------------------------
# Best practice: never export a work notebook at all. This is the backstop
# for when one slips through: notebooks whose name starts with one of these
# prefixes (or pages the model flags as employer content) go to a walled
# vault with no links, no actions, and no MCP access.
OZU_WORK_PREFIXES=work
OZU_WORK_VAULT_DIR=/home/USER/ozu-data/work-vault
# Uncomment ONLY if you want the work vault served over MCP:
# OZU_ALLOW_WORK_MCP=1

# --- MCP over HTTP (optional: stdio needs none of this) ------------------------
# `ozu mcp --http` will not start without a token. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OZU_MCP_TOKEN=
# The bind stays on loopback; put a TLS proxy in front (deploy/caddy-mcp.conf)
# and set PUBLIC_URL to the URL clients actually dial.
OZU_MCP_HOST=127.0.0.1
OZU_MCP_PORT=8321
# OZU_MCP_PUBLIC_URL=https://ozu.example.com

# --- ink detection -----------------------------------------------------------------
# A returning Ozu document is compared with the copy that was sent; pages
# with no new handwriting are never sent to the vision API. 0 reads every page.
OZU_INK_DETECT=1
OZU_INK_THRESHOLD=100
